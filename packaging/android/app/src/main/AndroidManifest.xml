<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== Android TV =====================================================
         Without the three declarations below the Shield will install the app
         and then never show it: the TV launcher only lists activities with the
         LEANBACK_LAUNCHER category, and Play/launcher filtering drops anything
         that claims to require a touchscreen (a TV has none).
         ===================================================================== -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- The game is driven entirely by gamepads; say so, but don't make it a
         hard requirement or a device with no pad paired yet couldn't install. -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER is what puts Toot and Scoot on the Shield
                     home screen. LAUNCHER is kept so the same APK still appears
                     on a phone or tablet. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <!-- INTERNET is required even though the game is fully bundled: Capacitor
         serves the local files over https://localhost through a WebView, which
         counts as a network request. Nothing leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
